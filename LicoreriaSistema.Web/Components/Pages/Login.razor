@page "/login"

@attribute [AllowAnonymous]

@layout LoginLayout

@using Microsoft.AspNetCore.Authorization

<PageTitle>Iniciar sesión</PageTitle>

<div class="login-container">
    <div class="login-card">

        <div class="login-header">
            <h1>Licorería Sistema</h1>
            <p>Iniciar sesión</p>
        </div>

        @if (MostrarErrorCredenciales)
        {
            <div class="alert alert-danger login-error" role="alert">
                Usuario o contraseña incorrectos.
            </div>
        }

        <form method="post" action="/api/auth/login">

            <div class="mb-3">
                <label for="nombreUsuario" class="form-label">
                    Usuario
                </label>

                <input id="nombreUsuario"
                       name="NombreUsuario"
                       type="text"
                       class="form-control"
                       autocomplete="username"
                       required />
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">
                    Contraseña
                </label>

                <input id="password"
                       name="Password"
                       type="password"
                       class="form-control"
                       autocomplete="current-password"
                       required />
            </div>

            <input type="hidden"
                   name="ReturnUrl"
                   value="@ReturnUrlSeguro" />

            <button type="submit"
                    class="btn btn-primary w-100">
                Ingresar
            </button>

        </form>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private bool MostrarErrorCredenciales =>
        string.Equals(
            Error,
            "credenciales",
            StringComparison.OrdinalIgnoreCase);

    private string ReturnUrlSeguro
    {
        get
        {
            if (string.IsNullOrWhiteSpace(ReturnUrl))
            {
                return "/";
            }

            if (!ReturnUrl.StartsWith(
                    "/",
                    StringComparison.Ordinal))
            {
                return "/";
            }

            if (ReturnUrl.StartsWith(
                    "//",
                    StringComparison.Ordinal))
            {
                return "/";
            }

            if (ReturnUrl.StartsWith(
                    "/\\",
                    StringComparison.Ordinal))
            {
                return "/";
            }

            if (Uri.TryCreate(
                    ReturnUrl,
                    UriKind.Absolute,
                    out _))
            {
                return "/";
            }

            return ReturnUrl;
        }
    }
}

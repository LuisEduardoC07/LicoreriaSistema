@page "/categorias"

@attribute [Authorize]

@rendermode InteractiveServer

@using LicoreriaSistema.Dominio.Entidades
@using LibreriaSistema.Aplicacion.Servicios

@inject CategoriaService CategoriaService

<PageTitle>Categorías</PageTitle>

<div class="categorias-page">

    <div class="page-header">
        <div>
            <h1>Categorías</h1>
            <p class="page-subtitle">
                Administra las categorías de productos de la licorería.
            </p>
        </div>

        <button type="button"
                class="btn btn-primary"
                @onclick="PrepararNuevaCategoria">
            <span class="button-icon">+</span>
            Nueva categoría
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(Mensaje))
    {
        <div class="alert @(MensajeExitoso ? "alert-success" : "alert-danger") alert-dismissible-custom"
             role="alert">
            @Mensaje

            <button type="button"
                    class="alert-close"
                    @onclick="LimpiarMensaje">
                ×
            </button>
        </div>
    }

    <div class="toolbar-card">

        <div class="search-box">
            <span class="search-icon">⌕</span>

            <input type="text"
                   class="form-control"
                   placeholder="Buscar por nombre o descripción..."
                   @bind="TextoBusqueda"
                   @bind:event="oninput" />
        </div>

        <div class="filter-group">

            <button type="button"
                    class="filter-button @(MostrarSoloActivas ? "active" : "")"
                    @onclick="AlternarFiltroActivas">
                @(MostrarSoloActivas ? "Solo activas" : "Todas")
            </button>

            <span class="result-count">
                @CategoriasFiltradas.Count categoría@(CategoriasFiltradas.Count == 1 ? "" : "s")
            </span>

        </div>
    </div>

    @if (Cargando)
    {
        <div class="loading-card">
            <div class="spinner-border" role="status"></div>
            <span>Cargando categorías...</span>
        </div>
    }
    else if (MostrarFormulario)
    {
        <div class="form-card">

            <div class="form-card-header">

                <div>
                    <h2>
                        @(Editando
                            ? "Editar categoría"
                            : "Nueva categoría")
                    </h2>

                    <p>
                        @(Editando
                            ? "Actualiza la información de la categoría."
                            : "Registra una nueva categoría para tus productos.")
                    </p>
                </div>

                <button type="button"
                        class="btn-close-custom"
                        title="Cerrar"
                        @onclick="CancelarFormulario">
                    ×
                </button>

            </div>

            <div class="form-grid">

                <div class="form-field">

                    <label for="nombreCategoria">
                        Nombre <span class="required">*</span>
                    </label>

                    <input id="nombreCategoria"
                           type="text"
                           class="form-control"
                           maxlength="100"
                           placeholder="Ej. Cervezas"
                           @bind="NombreFormulario"
                           @bind:event="oninput" />

                    @if (MostrarErrorNombre)
                    {
                        <div class="field-error">
                            El nombre de la categoría es obligatorio.
                        </div>
                    }

                </div>

                <div class="form-field">

                    <label for="descripcionCategoria">
                        Descripción
                    </label>

                    <input id="descripcionCategoria"
                           type="text"
                           class="form-control"
                           maxlength="250"
                           placeholder="Descripción de la categoría"
                           @bind="DescripcionFormulario"
                           @bind:event="oninput" />

                </div>

                @if (Editando)
                {
                    <div class="form-field form-field-checkbox">

                        <label class="checkbox-label">

                            <input type="checkbox"
                                   @bind="ActivaFormulario" />

                            <span>Categoría activa</span>

                        </label>

                    </div>
                }

            </div>

            <div class="form-actions">

                <button type="button"
                        class="btn btn-secondary"
                        @onclick="CancelarFormulario"
                        disabled="@Guardando">
                    Cancelar
                </button>

                <button type="button"
                        class="btn btn-primary"
                        @onclick="GuardarCategoria"
                        disabled="@Guardando">

                    @if (Guardando)
                    {
                        <span class="spinner-border spinner-border-sm me-2"
                              role="status">
                        </span>
                    }

                    @(Editando
                        ? "Guardar cambios"
                        : "Crear categoría")

                </button>

            </div>

        </div>
    }

    <div class="table-card">

        @if (CategoriasFiltradas.Count == 0)
        {
            <div class="empty-state">

                <div class="empty-icon">▦</div>

                <h3>No hay categorías</h3>

                <p>
                    @(string.IsNullOrWhiteSpace(TextoBusqueda)
                        ? "Todavía no se han registrado categorías."
                        : "No encontramos categorías que coincidan con la búsqueda.")
                </p>

                @if (string.IsNullOrWhiteSpace(TextoBusqueda))
                {
                    <button type="button"
                            class="btn btn-primary"
                            @onclick="PrepararNuevaCategoria">
                        Crear primera categoría
                    </button>
                }

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table categories-table">

                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th class="text-center">Productos</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var categoria in CategoriasFiltradas)
                        {
                            <tr>

                                <td>
                                    <div class="category-name">
                                        <span class="category-dot"></span>
                                        @categoria.Nombre
                                    </div>
                                </td>

                                <td>
                                    <span class="description-cell">
                                        @(string.IsNullOrWhiteSpace(categoria.Descripcion)
                                            ? "Sin descripción"
                                            : categoria.Descripcion)
                                    </span>
                                </td>

                                <td class="text-center">
                                    <span class="product-count">
                                        @categoria.Productos.Count
                                    </span>
                                </td>

                                <td class="text-center">

                                    @if (categoria.Activa)
                                    {
                                        <span class="status-badge active">
                                            Activa
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge inactive">
                                            Inactiva
                                        </span>
                                    }

                                </td>

                                <td class="text-end">

                                    <div class="action-buttons">

                                        <button type="button"
                                                class="btn-action edit"
                                                title="Editar"
                                                @onclick="() => PrepararEdicion(categoria)">
                                            Editar
                                        </button>

                                        @if (categoria.Activa)
                                        {
                                            <button type="button"
                                                    class="btn-action disable"
                                                    title="Desactivar"
                                                    @onclick="() => CambiarEstado(categoria, false)">
                                                Desactivar
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn-action enable"
                                                    title="Activar"
                                                    @onclick="() => CambiarEstado(categoria, true)">
                                                Activar
                                            </button>
                                        }

                                        <button type="button"
                                                class="btn-action delete"
                                                title="Eliminar"
                                                @onclick="() => EliminarCategoria(categoria)">
                                            Eliminar
                                        </button>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>

@code {

    private List<Categoria> ListaCategorias { get; set; } = new();

    private string TextoBusqueda { get; set; } = string.Empty;

    private bool MostrarSoloActivas { get; set; }

    private bool MostrarFormulario { get; set; }

    private bool Editando { get; set; }

    private bool Cargando { get; set; }

    private bool Guardando { get; set; }

    private bool MostrarErrorNombre { get; set; }

    private int CategoriaEditandoId { get; set; }

    private string NombreFormulario { get; set; } = string.Empty;

    private string DescripcionFormulario { get; set; } = string.Empty;

    private bool ActivaFormulario { get; set; } = true;

    private string Mensaje { get; set; } = string.Empty;

    private bool MensajeExitoso { get; set; }

    private List<Categoria> CategoriasFiltradas
    {
        get
        {
            IEnumerable<Categoria> consulta =
                ListaCategorias;

            if (MostrarSoloActivas)
            {
                consulta = consulta.Where(
                    c => c.Activa);
            }

            if (!string.IsNullOrWhiteSpace(
                    TextoBusqueda))
            {
                var busqueda =
                    TextoBusqueda.Trim();

                consulta = consulta.Where(c =>
                    c.Nombre.Contains(
                        busqueda,
                        StringComparison.OrdinalIgnoreCase)
                    ||
                    c.Descripcion.Contains(
                        busqueda,
                        StringComparison.OrdinalIgnoreCase));
            }

            return consulta
                .OrderBy(c => c.Nombre)
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarCategoriasAsync();
    }

    private async Task CargarCategoriasAsync()
    {
        Cargando = true;

        try
        {
            var categorias =
                await CategoriaService.ObtenerTodasAsync(
                    incluirInactivas: true);

            ListaCategorias =
                categorias.ToList();
        }
        catch (Exception ex)
        {
            MostrarMensaje(
                false,
                $"No fue posible cargar las categorías: {ex.Message}");
        }
        finally
        {
            Cargando = false;
        }
    }

    private void PrepararNuevaCategoria()
    {
        Editando = false;

        CategoriaEditandoId = 0;

        NombreFormulario =
            string.Empty;

        DescripcionFormulario =
            string.Empty;

        ActivaFormulario = true;

        MostrarErrorNombre = false;

        MostrarFormulario = true;

        LimpiarMensaje();
    }

    private void PrepararEdicion(
        Categoria categoria)
    {
        Editando = true;

        CategoriaEditandoId =
            categoria.Id;

        NombreFormulario =
            categoria.Nombre;

        DescripcionFormulario =
            categoria.Descripcion;

        ActivaFormulario =
            categoria.Activa;

        MostrarErrorNombre = false;

        MostrarFormulario = true;

        LimpiarMensaje();
    }

    private void CancelarFormulario()
    {
        MostrarFormulario = false;

        Editando = false;

        CategoriaEditandoId = 0;

        NombreFormulario =
            string.Empty;

        DescripcionFormulario =
            string.Empty;

        ActivaFormulario = true;

        MostrarErrorNombre = false;
    }

    private async Task GuardarCategoria()
    {
        MostrarErrorNombre =
            string.IsNullOrWhiteSpace(
                NombreFormulario);

        if (MostrarErrorNombre)
        {
            MostrarMensaje(
                false,
                "El nombre de la categoría es obligatorio.");

            return;
        }

        Guardando = true;

        try
        {
            var resultado = Editando
                ? await CategoriaService.ActualizarAsync(
                    CategoriaEditandoId,
                    NombreFormulario,
                    DescripcionFormulario,
                    ActivaFormulario)

                : await CategoriaService.CrearAsync(
                    NombreFormulario,
                    DescripcionFormulario);

            MostrarMensaje(
                resultado.Exitoso,
                resultado.Mensaje);

            if (resultado.Exitoso)
            {
                CancelarFormulario();

                await CargarCategoriasAsync();
            }
        }
        catch (Exception ex)
        {
            MostrarMensaje(
                false,
                $"Ocurrió un error al guardar la categoría: {ex.Message}");
        }
        finally
        {
            Guardando = false;
        }
    }

    private async Task CambiarEstado(
        Categoria categoria,
        bool nuevoEstado)
    {
        var resultado =
            await CategoriaService.CambiarEstadoAsync(
                categoria.Id,
                nuevoEstado);

        MostrarMensaje(
            resultado.Exitoso,
            resultado.Mensaje);

        if (resultado.Exitoso)
        {
            await CargarCategoriasAsync();
        }
    }

    private async Task EliminarCategoria(
        Categoria categoria)
    {
        var resultado =
            await CategoriaService.EliminarAsync(
                categoria.Id);

        MostrarMensaje(
            resultado.Exitoso,
            resultado.Mensaje);
    }

    private void AlternarFiltroActivas()
    {
        MostrarSoloActivas =
            !MostrarSoloActivas;
    }

    private void MostrarMensaje(
        bool exitoso,
        string mensaje)
    {
        MensajeExitoso = exitoso;
        Mensaje = mensaje;
    }

    private void LimpiarMensaje()
    {
        Mensaje = string.Empty;
        MensajeExitoso = false;
    }
}

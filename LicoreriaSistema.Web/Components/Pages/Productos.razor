@page "/productos"


@attribute [Authorize(Policy = "Permiso:PRODUCTOS_CONSULTAR")]
@attribute [Authorize]

@rendermode InteractiveServer

@using LicoreriaSistema.Dominio.Entidades
@using LibreriaSistema.Aplicacion.Servicios

@inject ProductoService ProductoService
@inject CategoriaService CategoriaService
@inject LicoreriaSistema.Web.Servicios.OpenFoodFactsImagenService OpenFoodFactsImagenService

<PageTitle>Productos</PageTitle>

<div class="productos-page">

    <div class="page-header">
        <div>
            <h1>Productos</h1>
            <p class="page-subtitle">
                Administra los productos y cÃ³digos de barras de la licorerÃ­a.
            </p>
        </div>

        <button type="button"
                class="btn btn-primary"
                @onclick="PrepararNuevoProducto">
            <span class="button-icon">+</span>
            Nuevo producto
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(Mensaje))
    {
        <div class="alert @(MensajeExitoso ? "alert-success" : "alert-danger") alert-dismissible-custom"
             role="alert">
            @Mensaje

            <button type="button"
                    class="alert-close"
                    @onclick="LimpiarMensaje">
                Ã—
            </button>
        </div>
    }

    <div class="toolbar-card">

        <div class="search-box">
            <span class="search-icon">âŒ•</span>

            <input type="text"
                   class="form-control"
                   placeholder="Buscar por nombre o cÃ³digo de barras..."
                   @bind="TextoBusqueda"
                   @bind:event="oninput" />
        </div>

        <div class="filters">

            <select class="form-select category-filter"
                    @bind="CategoriaFiltro">
                <option value="0">Todas las categorÃ­as</option>

                @foreach (var categoria in ListaCategorias.OrderBy(c => c.Nombre))
                {
                    <option value="@categoria.Id">
                        @categoria.Nombre
                    </option>
                }
            </select>

            <button type="button"
                    class="filter-button @(MostrarSoloActivos ? "active" : "")"
                    @onclick="AlternarFiltroActivos">
                @(MostrarSoloActivos ? "Solo activos" : "Todos")
            </button>

            <span class="result-count">
                @ProductosFiltrados.Count producto@(ProductosFiltrados.Count == 1 ? "" : "s")
            </span>

        </div>
    </div>

    @if (Cargando)
    {
        <div class="loading-card">
            <div class="spinner-border" role="status"></div>
            <span>Cargando productos...</span>
        </div>
    }
    else if (MostrarFormulario)
    {
        <div class="form-card">

            <div class="form-card-header">

                <div>
                    <h2>
                        @(Editando ? "Editar producto" : "Nuevo producto")
                    </h2>

                    <p>
                        @(Editando
                            ? "Actualiza la informaciÃ³n del producto."
                            : "Registra un producto y su cÃ³digo de barras.")
                    </p>
                </div>

                <button type="button"
                        class="btn-close-custom"
                        title="Cerrar"
                        @onclick="CancelarFormulario">
                    Ã—
                </button>

            </div>

            <div class="form-grid">

                <div class="form-field field-wide">

                    <label for="nombreProducto">
                        Nombre <span class="required">*</span>
                    </label>

                    <input id="nombreProducto"
                           type="text"
                           class="form-control"
                           maxlength="150"
                           placeholder="Ej. Presidente 12 oz"
                           @bind="NombreFormulario"
                           @bind:event="oninput" />

                    @if (MostrarErrorNombre)
                    {
                        <div class="field-error">
                            El nombre del producto es obligatorio.
                        </div>
                    }

                </div>

                <div class="form-field">

                    <label for="codigoProducto">
                        CÃ³digo de barras <span class="required">*</span>
                    </label>

                    <input id="codigoProducto"
                           type="text"
                           class="form-control barcode-input"
                           maxlength="50"
                           inputmode="numeric"
                           autocomplete="off"
                           placeholder="Escanea o escribe el cÃ³digo"
                           @bind="CodigoFormulario"
                           @bind:event="oninput" />

                    <div class="field-help">
                        Este campo estÃ¡ preparado para lectores USB/Bluetooth.
                    </div>

                    @if (MostrarErrorCodigo)
                    {
                        <div class="field-error">
                            El cÃ³digo de barras es obligatorio.
                        </div>
                    }

                </div>

                <div class="form-field">

                    <label for="categoriaProducto">
                        CategorÃ­a <span class="required">*</span>
                    </label>

                    <select id="categoriaProducto"
                            class="form-select"
                            @bind="CategoriaFormulario">

                        <option value="0">
                            Seleccionar categorÃ­a
                        </option>

                        @foreach (var categoria in ListaCategorias.OrderBy(c => c.Nombre))
                        {
                            <option value="@categoria.Id">
                                @categoria.Nombre
                                @(!categoria.Activa ? " (Inactiva)" : "")
                            </option>
                        }

                    </select>

                    @if (MostrarErrorCategoria)
                    {
                        <div class="field-error">
                            Debes seleccionar una categorÃ­a.
                        </div>
                    }

                </div>

                <div class="form-field">

                    <label for="precioCompra">
                        Precio de compra <span class="required">*</span>
                    </label>

                    <input id="precioCompra"
                           type="number"
                           class="form-control"
                           min="0"
                           step="0.01"
                           @bind="PrecioCompraFormulario" />

                </div>

                <div class="form-field">

                    <label for="precioVenta">
                        Precio de venta <span class="required">*</span>
                    </label>

                    <input id="precioVenta"
                           type="number"
                           class="form-control"
                           min="0.01"
                           step="0.01"
                           @bind="PrecioVentaFormulario" />

                </div>

<div class="form-field field-wide">
    <label for="buscarImagenProducto">Buscar imagen en Open Food Facts</label>

    <div style="display:flex;gap:8px;flex-wrap:wrap;">
        <input id="buscarImagenProducto"
               type="text"
               class="form-control"
               placeholder="Nombre del producto o código de barras"
               @bind="TextoBusquedaImagen"
               @bind:event="oninput" />

        <button type="button"
                class="btn btn-secondary"
                @onclick="BuscarImagenesAsync"
                disabled="@BuscandoImagenes">
            @(BuscandoImagenes ? "Buscando..." : "Buscar imágenes")
        </button>
    </div>

    <div class="field-help">
        Se buscará primero por código de barras y, si no hay imágenes,
        por nombre. Revisa cada resultado antes de seleccionarlo.
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorBusquedaImagen))
    {
        <p role="alert" style="color:#b42318;">
            @ErrorBusquedaImagen
        </p>
    }

    @if (CandidatosImagen.Count > 0)
    {
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:12px;margin-top:12px;">
            @foreach (var candidato in CandidatosImagen)
            {
                <div @key="candidato.Url"
                     style="border:1px solid #d0d5dd;border-radius:8px;padding:10px;">
                    <img src="@candidato.Url"
                         alt="@candidato.Nombre"
                         loading="lazy"
                         style="width:100%;height:150px;object-fit:contain;"
                         onerror="this.style.display='none';" />

                    <div style="font-weight:600;margin-top:8px;">
                        @candidato.Nombre
                    </div>

                    @if (!string.IsNullOrWhiteSpace(candidato.Marca))
                    {
                        <div class="field-help">Marca: @candidato.Marca</div>
                    }

                    @if (!string.IsNullOrWhiteSpace(candidato.Codigo))
                    {
                        <div class="field-help">Código: @candidato.Codigo</div>
                    }

                    <button type="button"
                            class="btn btn-secondary"
                            style="margin-top:8px;width:100%;"
                            @onclick="() => SeleccionarCandidatoImagen(candidato)">
                        @(CandidatoImagenSeleccionado?.Url == candidato.Url
                            ? "Seleccionado"
                            : "Seleccionar")
                    </button>
                </div>
            }
        </div>

        @if (CandidatoImagenSeleccionado is not null)
        {
            <div style="margin-top:12px;">
                <p>
                    Selección:
                    <strong>@CandidatoImagenSeleccionado.Nombre</strong>
                </p>
                <button type="button"
                        class="btn btn-primary"
                        @onclick="UsarImagenSeleccionada">
                    Usar esta imagen
                </button>
            </div>
        }
    }
    else if (BusquedaRealizada && string.IsNullOrWhiteSpace(ErrorBusquedaImagen))
    {
        <p class="field-help">
            No se encontraron imágenes. Puedes probar con otro nombre o introducir una URL manualmente.
        </p>
    }
</div>
                <div class="form-field field-wide image-url-field">
                    <label for="imagenUrlProducto">Imagen del producto (URL)</label>

                    <input id="imagenUrlProducto"
                           type="url"
                           class="form-control"
                           maxlength="1000"
                           placeholder="https://ejemplo.com/imagen.jpg"
                           @bind="ImagenUrlFormulario"
                           @bind:event="oninput" />

                    <div class="field-help">
                        Introduce una URL HTTPS/HTTP. La imagen se guardarÃ¡ junto con el producto.
                    </div>

                    @if (!string.IsNullOrWhiteSpace(ImagenUrlFormulario))
                    {
                        <div class="image-url-preview">
                            <img src="@ImagenUrlFormulario"
                                 alt="Vista previa del producto"
                                 style="max-width:180px;max-height:180px;object-fit:contain;"
                                 onerror="this.style.display='none';" />

                            <button type="button"
                                    class="btn btn-secondary"
                                    @onclick="QuitarImagenFormulario">
                                Quitar imagen
                            </button>
                        </div>
                    }
                </div>

                <div class="form-field field-wide">

                    <label for="descripcionProducto">
                        DescripciÃ³n
                    </label>

                    <textarea id="descripcionProducto"
                              class="form-control"
                              maxlength="250"
                              rows="3"
                              placeholder="DescripciÃ³n del producto"
                              @bind="DescripcionFormulario"
                              @bind:event="oninput"></textarea>

                </div>

                @if (Editando)
                {
                    <div class="form-field form-field-checkbox">

                        <label class="checkbox-label">

                            <input type="checkbox"
                                   @bind="ActivoFormulario" />

                            <span>Producto activo</span>

                        </label>

                    </div>
                }

            </div>

            <div class="form-actions">

                <button type="button"
                        class="btn btn-secondary"
                        @onclick="CancelarFormulario"
                        disabled="@Guardando">
                    Cancelar
                </button>

                <button type="button"
                        class="btn btn-primary"
                        @onclick="GuardarProducto"
                        disabled="@Guardando">

                    @if (Guardando)
                    {
                        <span class="spinner-border spinner-border-sm me-2"
                              role="status">
                        </span>
                    }

                    @(Editando ? "Guardar cambios" : "Crear producto")
                </button>

            </div>

        </div>
    }

    <div class="table-card">

        @if (ProductosFiltrados.Count == 0)
        {
            <div class="empty-state">

                <div class="empty-icon">â–¦</div>

                <h3>No hay productos</h3>

                <p>
                    @(string.IsNullOrWhiteSpace(TextoBusqueda)
                        ? "TodavÃ­a no se han registrado productos."
                        : "No encontramos productos que coincidan con la bÃºsqueda.")
                </p>

                @if (string.IsNullOrWhiteSpace(TextoBusqueda))
                {
                    <button type="button"
                            class="btn btn-primary"
                            @onclick="PrepararNuevoProducto">
                        Crear primer producto
                    </button>
                }

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table products-table">

                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>CÃ³digo de barras</th>
                            <th>CategorÃ­a</th>
                            <th class="text-end">Compra</th>
                            <th class="text-end">Venta</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var producto in ProductosFiltrados)
                        {
                            <tr>

                                <td>
                                    <div class="product-name">
                                        <span class="product-dot"></span>

                                        <div>
                                            <strong>
                                                @producto.Nombre
                                            </strong>

                                            @if (!string.IsNullOrWhiteSpace(producto.Descripcion))
                                            {
                                                <small>
                                                    @producto.Descripcion
                                                </small>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <code class="barcode-code">
                                        @producto.Codigo
                                    </code>
                                </td>

                                <td>
                                    <span class="category-badge">
                                        @producto.Categoria.Nombre
                                    </span>
                                </td>

                                <td class="text-end">
                                    RD$ @producto.PrecioCompra.ToString("N2")
                                </td>

                                <td class="text-end price-sale">
                                    RD$ @producto.PrecioVenta.ToString("N2")
                                </td>

                                <td class="text-center">

                                    @if (producto.Activo)
                                    {
                                        <span class="status-badge active">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge inactive">
                                            Inactivo
                                        </span>
                                    }

                                </td>

                                <td class="text-end">

                                    <div class="action-buttons">

                                        <button type="button"
                                                class="btn-action edit"
                                                @onclick="() => PrepararEdicion(producto)">
                                            Editar
                                        </button>

                                        @if (producto.Activo)
                                        {
                                            <button type="button"
                                                    class="btn-action disable"
                                                    @onclick="() => CambiarEstado(producto, false)">
                                                Desactivar
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn-action enable"
                                                    @onclick="() => CambiarEstado(producto, true)">
                                                Activar
                                            </button>
                                        }

                                        <button type="button"
                                                class="btn-action delete"
                                                @onclick="() => EliminarProducto(producto)">
                                            Eliminar
                                        </button>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>

@code {

    private List<Producto> ListaProductos { get; set; } = new();

    private List<Categoria> ListaCategorias { get; set; } = new();

    private string TextoBusqueda { get; set; } = string.Empty;

    private int CategoriaFiltro { get; set; }

    private bool MostrarSoloActivos { get; set; }

    private bool MostrarFormulario { get; set; }

    private bool Editando { get; set; }

    private bool Cargando { get; set; }

    private bool Guardando { get; set; }

    private bool MostrarErrorNombre { get; set; }

    private bool MostrarErrorCodigo { get; set; }

    private bool MostrarErrorCategoria { get; set; }

    private int ProductoEditandoId { get; set; }

    private string NombreFormulario { get; set; } = string.Empty;

    private string CodigoFormulario { get; set; } = string.Empty;

    private string DescripcionFormulario { get; set; } = string.Empty;

    private string? ImagenUrlFormulario { get; set; }
    private string TextoBusquedaImagen { get; set; } = string.Empty;
    private List<LicoreriaSistema.Web.Servicios.CandidatoImagenProducto> CandidatosImagen { get; set; } = new();
    private LicoreriaSistema.Web.Servicios.CandidatoImagenProducto? CandidatoImagenSeleccionado { get; set; }
    private bool BuscandoImagenes { get; set; }
    private bool BusquedaRealizada { get; set; }
    private string? ErrorBusquedaImagen { get; set; }

    private decimal PrecioCompraFormulario { get; set; }

    private decimal PrecioVentaFormulario { get; set; }

    private int CategoriaFormulario { get; set; }

    private bool ActivoFormulario { get; set; } = true;

    private string Mensaje { get; set; } = string.Empty;

    private bool MensajeExitoso { get; set; }

    private List<Producto> ProductosFiltrados
    {
        get
        {
            IEnumerable<Producto> consulta =
                ListaProductos;

            if (MostrarSoloActivos)
            {
                consulta = consulta.Where(
                    p => p.Activo);
            }

            if (CategoriaFiltro > 0)
            {
                consulta = consulta.Where(
                    p => p.CategoriaId == CategoriaFiltro);
            }

            if (!string.IsNullOrWhiteSpace(TextoBusqueda))
            {
                var busqueda =
                    TextoBusqueda.Trim();

                consulta = consulta.Where(p =>
                    p.Nombre.Contains(
                        busqueda,
                        StringComparison.OrdinalIgnoreCase)
                    ||
                    p.Codigo.Contains(
                        busqueda,
                        StringComparison.OrdinalIgnoreCase)
                    ||
                    (!string.IsNullOrWhiteSpace(p.Descripcion) &&
                     p.Descripcion.Contains(
                         busqueda,
                         StringComparison.OrdinalIgnoreCase)));
            }

            return consulta
                .OrderBy(p => p.Nombre)
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarDatosAsync();
    }

    private async Task CargarDatosAsync()
    {
        Cargando = true;

        try
        {
            var productos =
                await ProductoService.ObtenerTodasAsync(
                    incluirInactivos: true);

            var categorias =
                await CategoriaService.ObtenerTodasAsync(
                    incluirInactivas: true);

            ListaProductos =
                productos.ToList();

            ListaCategorias =
                categorias.ToList();
        }
        catch (Exception ex)
        {
            MostrarMensaje(
                false,
                $"No fue posible cargar los productos: {ex.Message}");
        }
        finally
        {
            Cargando = false;
        }
    }

    private void PrepararNuevoProducto()
    {
        Editando = false;
        ProductoEditandoId = 0;

        NombreFormulario = string.Empty;
        CodigoFormulario = string.Empty;
        DescripcionFormulario = string.Empty;
        ImagenUrlFormulario = null;
        TextoBusquedaImagen = string.Empty;
        CandidatosImagen.Clear();
        CandidatoImagenSeleccionado = null;
        BusquedaRealizada = false;
        ErrorBusquedaImagen = null;

        PrecioCompraFormulario = 0;
        PrecioVentaFormulario = 0;

        CategoriaFormulario = 0;
        ActivoFormulario = true;

        MostrarErrorNombre = false;
        MostrarErrorCodigo = false;
        MostrarErrorCategoria = false;

        MostrarFormulario = true;

        LimpiarMensaje();
    }

    private void PrepararEdicion(Producto producto)
    {
        Editando = true;
        ProductoEditandoId = producto.Id;

        NombreFormulario = producto.Nombre;
        CodigoFormulario = producto.Codigo;
        DescripcionFormulario = producto.Descripcion ?? string.Empty;
        ImagenUrlFormulario = producto.ImagenUrl;
        TextoBusquedaImagen = string.Empty;
        CandidatosImagen.Clear();
        CandidatoImagenSeleccionado = null;
        BusquedaRealizada = false;
        ErrorBusquedaImagen = null;

        PrecioCompraFormulario = producto.PrecioCompra;
        PrecioVentaFormulario = producto.PrecioVenta;

        CategoriaFormulario = producto.CategoriaId;
        ActivoFormulario = producto.Activo;

        MostrarErrorNombre = false;
        MostrarErrorCodigo = false;
        MostrarErrorCategoria = false;

        MostrarFormulario = true;

        LimpiarMensaje();
    }

    private void CancelarFormulario()
    {
        MostrarFormulario = false;
        Editando = false;
        ProductoEditandoId = 0;

        NombreFormulario = string.Empty;
        CodigoFormulario = string.Empty;
        DescripcionFormulario = string.Empty;
        ImagenUrlFormulario = null;
        TextoBusquedaImagen = string.Empty;
        CandidatosImagen.Clear();
        CandidatoImagenSeleccionado = null;
        BusquedaRealizada = false;
        ErrorBusquedaImagen = null;

        PrecioCompraFormulario = 0;
        PrecioVentaFormulario = 0;

        CategoriaFormulario = 0;
        ActivoFormulario = true;

        MostrarErrorNombre = false;
        MostrarErrorCodigo = false;
        MostrarErrorCategoria = false;
    }

    private async Task GuardarProducto()
    {
        MostrarErrorNombre =
            string.IsNullOrWhiteSpace(
                NombreFormulario);

        MostrarErrorCodigo =
            string.IsNullOrWhiteSpace(
                CodigoFormulario);

        MostrarErrorCategoria =
            CategoriaFormulario <= 0;

        if (MostrarErrorNombre ||
            MostrarErrorCodigo ||
            MostrarErrorCategoria)
        {
            MostrarMensaje(
                false,
                "Completa los campos obligatorios del producto.");

            return;
        }

        Guardando = true;

        try
        {
            var resultado = Editando
                ? await ProductoService.ActualizarAsync(
                    ProductoEditandoId,
                    NombreFormulario,
                    CodigoFormulario,
                    DescripcionFormulario,
                    PrecioCompraFormulario,
                    PrecioVentaFormulario,
                    CategoriaFormulario,
                    ActivoFormulario,
                    imagenUrl: ObtenerImagenUrlValidada())

                : await ProductoService.CrearAsync(
                    NombreFormulario,
                    CodigoFormulario,
                    DescripcionFormulario,
                    PrecioCompraFormulario,
                    PrecioVentaFormulario,
                    CategoriaFormulario,
                    imagenUrl: ObtenerImagenUrlValidada());

            MostrarMensaje(
                resultado.Exitoso,
                resultado.Mensaje);

            if (resultado.Exitoso)
            {
                CancelarFormulario();

                await CargarDatosAsync();
            }
        }
        catch (Exception ex)
        {
            MostrarMensaje(
                false,
                $"OcurriÃ³ un error al guardar el producto: {ex.Message}");
        }
        finally
        {
            Guardando = false;
        }
    }

    private async Task BuscarImagenesAsync()
    {
        if (BuscandoImagenes)
            return;

        BuscandoImagenes = true;
        BusquedaRealizada = false;
        ErrorBusquedaImagen = null;
        CandidatosImagen.Clear();
        CandidatoImagenSeleccionado = null;

        try
        {
            var termino = TextoBusquedaImagen.Trim();
            var soloDigitos = new string(termino.Where(char.IsDigit).ToArray());
            IReadOnlyList<LicoreriaSistema.Web.Servicios.CandidatoImagenProducto> resultados =
                Array.Empty<LicoreriaSistema.Web.Servicios.CandidatoImagenProducto>();

            // Primero se intenta una búsqueda exacta por código de barras.
            if (soloDigitos.Length >= 8 && soloDigitos.Length <= 14)
            {
                resultados = await OpenFoodFactsImagenService.BuscarPorCodigoAsync(soloDigitos);
            }

            // Si no hay resultados con imagen, se busca por nombre.
            if (resultados.Count == 0)
            {
                var nombreBusqueda = string.IsNullOrWhiteSpace(termino)
                    ? NombreFormulario.Trim()
                    : termino;

                resultados = await OpenFoodFactsImagenService.BuscarPorNombreAsync(nombreBusqueda);
            }

            CandidatosImagen = resultados.ToList();
            BusquedaRealizada = true;
        }
        catch (HttpRequestException)
        {
            ErrorBusquedaImagen =
                "No se pudo conectar con Open Food Facts. Comprueba la conexión e inténtalo de nuevo.";
        }
        catch (TaskCanceledException)
        {
            ErrorBusquedaImagen =
                "La búsqueda tardó demasiado. Inténtalo de nuevo.";
        }
        catch (System.Text.Json.JsonException)
        {
            ErrorBusquedaImagen =
                "El servicio devolvió una respuesta que no se pudo interpretar.";
        }
        catch (Exception ex)
        {
            ErrorBusquedaImagen =
                $"No se pudo completar la búsqueda: {ex.Message}";
        }
        finally
        {
            BuscandoImagenes = false;
        }
    }

    private void SeleccionarCandidatoImagen(
        LicoreriaSistema.Web.Servicios.CandidatoImagenProducto candidato)
    {
        CandidatoImagenSeleccionado = candidato;
    }

    private void UsarImagenSeleccionada()
    {
        if (CandidatoImagenSeleccionado is null)
            return;

        ImagenUrlFormulario = CandidatoImagenSeleccionado.Url;
    }
    private string? ObtenerImagenUrlValidada()
    {
        if (string.IsNullOrWhiteSpace(ImagenUrlFormulario))
        {
            return string.Empty;
        }

        var valor = ImagenUrlFormulario.Trim();

        if (valor.Length > 1000 ||
            !Uri.TryCreate(valor, UriKind.Absolute, out var uri) ||
            (uri.Scheme != Uri.UriSchemeHttp &&
             uri.Scheme != Uri.UriSchemeHttps))
        {
            throw new ArgumentException(
                "La imagen debe tener una URL HTTP o HTTPS vÃ¡lida de hasta 1000 caracteres.");
        }

        return uri.AbsoluteUri;
    }

    private void QuitarImagenFormulario()
    {
        ImagenUrlFormulario = null;
        TextoBusquedaImagen = string.Empty;
        CandidatosImagen.Clear();
        CandidatoImagenSeleccionado = null;
        BusquedaRealizada = false;
        ErrorBusquedaImagen = null;
    }

    private async Task CambiarEstado(
        Producto producto,
        bool nuevoEstado)
    {
        var resultado =
            await ProductoService.CambiarEstadoAsync(
                producto.Id,
                nuevoEstado);

        MostrarMensaje(
            resultado.Exitoso,
            resultado.Mensaje);

        if (resultado.Exitoso)
        {
            await CargarDatosAsync();
        }
    }

    private async Task EliminarProducto(
        Producto producto)
    {
        var resultado =
            await ProductoService.EliminarAsync(
                producto.Id);

        MostrarMensaje(
            resultado.Exitoso,
            resultado.Mensaje);
    }

    private void AlternarFiltroActivos()
    {
        MostrarSoloActivos =
            !MostrarSoloActivos;
    }

    private void MostrarMensaje(
        bool exitoso,
        string mensaje)
    {
        MensajeExitoso = exitoso;
        Mensaje = mensaje;
    }

    private void LimpiarMensaje()
    {
        Mensaje = string.Empty;
        MensajeExitoso = false;
    }
}

</style>

@code {

    private FiltroHistorialVentas Filtro { get; set; } = new();

    private IReadOnlyList<Venta> Ventas { get; set; } =
        Array.Empty<Venta>();

    private Venta? VentaSeleccionada { get; set; }

    private bool Cargando { get; set; }

    private string Mensaje { get; set; } = string.Empty;

    private bool MensajeEsError { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await BuscarAsync();
    }

    private async Task BuscarAsync()
    {
        if (Cargando)
            return;

        Cargando = true;
        Mensaje = string.Empty;

        try
        {
            if (Filtro.Desde.HasValue &&
                Filtro.Hasta.HasValue &&
                Filtro.Desde.Value.Date > Filtro.Hasta.Value.Date)
            {
                Ventas = Array.Empty<Venta>();

                MostrarMensaje(
                    true,
                    "La fecha Desde no puede ser posterior a la fecha Hasta.");

                return;
            }

            Ventas =
                await VentaService.ObtenerHistorialAsync(Filtro);
        }
        catch (UnauthorizedAccessException ex)
        {
            Ventas = Array.Empty<Venta>();
            MostrarMensaje(true, ex.Message);
        }
        catch (Exception ex)
        {
            Ventas = Array.Empty<Venta>();

            MostrarMensaje(
                true,
                $"No fue posible cargar el historial: {ex.Message}");
        }
        finally
        {
            Cargando = false;
        }
    }

    private async Task LimpiarAsync()
    {
        Filtro = new FiltroHistorialVentas();

        await BuscarAsync();
    }

    private void VerDetalle(Venta venta)
    {
        VentaSeleccionada = venta;
    }

    private void CerrarDetalle()
    {
        VentaSeleccionada = null;
    }

    private void MostrarMensaje(bool esError, string mensaje)
    {
        MensajeEsError = esError;
        Mensaje = mensaje;
    }

    private void LimpiarMensaje()
    {
        Mensaje = string.Empty;
        MensajeEsError = false;
    }
}


@page "/historial-ventas"

@attribute [Authorize]
@rendermode InteractiveServer

@using LicoreriaSistema.Dominio.Entidades
@using LibreriaSistema.Aplicacion.Modelos
@using LibreriaSistema.Aplicacion.Servicios
@using LibreriaSistema.Aplicacion.Interfaces

@inject VentaService VentaService
@inject IContextoUsuarioActual ContextoUsuarioActual

<PageTitle>Historial de Ventas</PageTitle>

<div class="historial-page">

    <header class="historial-header">
        <div>
            <span class="historial-eyebrow">OPERACIONES</span>
            <h1>Historial de Ventas</h1>
            <p>
                Consulta las transacciones realizadas y revisa el detalle de cada factura.
            </p>
        </div>

        <a href="/punto-de-venta" class="historial-new-sale">
            + Nueva venta
        </a>
    </header>

    @if (!string.IsNullOrWhiteSpace(Mensaje))
    {
        <div class="historial-alert @(MensajeEsError ? "historial-alert-error" : "historial-alert-success")">
            <span>@Mensaje</span>

            <button type="button"
                    @onclick="LimpiarMensaje"
                    aria-label="Cerrar">
                ×
            </button>
        </div>
    }

    <section class="historial-filter-card">

        <div class="historial-section-heading">
            <div>
                <span class="historial-section-label">CONSULTA</span>
                <h2>Filtrar ventas</h2>
            </div>

            <span class="historial-sort-info">
                Más recientes primero
            </span>
        </div>

        <div class="historial-filter-grid">

            <div class="historial-field">
                <label for="desde">Desde</label>

                <InputDate id="desde"
                           TValue="DateTime?"
                           class="historial-input"
                           @bind-Value="Filtro.Desde" />
            </div>

            <div class="historial-field">
                <label for="hasta">Hasta</label>

                <InputDate id="hasta"
                           TValue="DateTime?"
                           class="historial-input"
                           @bind-Value="Filtro.Hasta" />
            </div>

            <div class="historial-field">
                <label for="factura">Número de factura</label>

                <InputText id="factura"
                           class="historial-input"
                           @bind-Value="Filtro.NumeroFactura"
                           placeholder="Ej. FAC-20260919" />
            </div>

            <div class="historial-field">
                <label for="cliente">Cliente / RNC</label>

                <InputText id="cliente"
                           class="historial-input"
                           @bind-Value="Filtro.Cliente"
                           placeholder="Nombre o RNC" />
            </div>

            <div class="historial-field">
                <label for="metodoPago">Método de pago</label>

                <InputSelect id="metodoPago"
                             class="historial-input"
                             @bind-Value="Filtro.MetodoPago">

                    <option value="">Todos</option>
                    <option value="Efectivo">Efectivo</option>
                    <option value="Tarjeta">Tarjeta</option>
                    <option value="Transferencia">Transferencia</option>

                </InputSelect>
            </div>

        </div>

        <div class="historial-filter-actions">

            <button type="button"
                    class="historial-button-primary"
                    @onclick="BuscarAsync"
                    disabled="@Cargando">

                @if (Cargando)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <span>Buscando...</span>
                }
                else
                {
                    <span>Buscar ventas</span>
                }

            </button>

            <button type="button"
                    class="historial-button-secondary"
                    @onclick="LimpiarAsync"
                    disabled="@Cargando">

                Limpiar filtros

            </button>

        </div>

    </section>

    <section class="historial-results-card">

        <div class="historial-results-header">

            <div>
                <span class="historial-section-label">RESULTADOS</span>
                <h2>Ventas realizadas</h2>
            </div>

            <div class="historial-results-count">
                @Ventas.Count venta(s)
            </div>

        </div>

        @if (Cargando)
        {
            <div class="historial-loading">

                <div class="spinner-border" role="status"></div>

                <strong>Cargando historial...</strong>

                <span>
                    Estamos consultando las transacciones.
                </span>

            </div>
        }
        else if (Ventas.Count == 0)
        {
            <div class="historial-empty">

                <div class="historial-empty-icon">
                    $
                </div>

                <h3>No hay ventas para mostrar</h3>

                <p>
                    Prueba cambiando el rango de fechas o alguno de los filtros.
                </p>

            </div>
        }
        else
        {
            <div class="historial-table-wrapper">

                <table class="historial-table">

                    <thead>
                        <tr>
                            <th>Factura</th>
                            <th>Fecha</th>
                            <th>Cliente</th>
                            <th>Sucursal</th>
                            <th>Cajero</th>
                            <th>Pago</th>
                            <th class="text-end">Subtotal</th>
                            <th class="text-end">ITBIS</th>
                            <th class="text-end">ISC</th>
                            <th class="text-end">Total</th>
                            <th>Estado</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var venta in Ventas)
                        {
                            <tr>

                                <td>
                                    <strong class="historial-invoice">
                                        @venta.NumeroFactura
                                    </strong>
                                </td>

                                <td>
                                    <div class="historial-date">
                                        @venta.Fecha.ToString("dd/MM/yyyy")
                                    </div>

                                    <small>
                                        @venta.Fecha.ToString("HH:mm:ss")
                                    </small>
                                </td>

                                <td>
                                    <div class="historial-client">
                                        @venta.NombreCliente
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(venta.RncCliente))
                                    {
                                        <small>
                                            RNC: @venta.RncCliente
                                        </small>
                                    }
                                </td>

                                <td>
                                    @venta.Sucursal.Nombre
                                </td>

                                <td>
                                    @venta.Usuario.Nombre
                                    @venta.Usuario.Apellido
                                </td>

                                <td>
                                    <span class="historial-payment">
                                        @venta.MetodoPago
                                    </span>
                                </td>

                                <td class="text-end">
                                    RD$ @venta.Subtotal.ToString("N2")
                                </td>

                                <td class="text-end">
                                    RD$ @venta.Itbis.ToString("N2")
                                </td>

                                <td class="text-end">
                                    RD$ @venta.Isc.ToString("N2")
                                </td>

                                <td class="text-end">
                                    <strong>
                                        RD$ @venta.Total.ToString("N2")
                                    </strong>
                                </td>

                                <td>
                                    @if (string.Equals(
                                        venta.Estado,
                                        "Completada",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="historial-status historial-status-success">
                                            Completada
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="historial-status">
                                            @venta.Estado
                                        </span>
                                    }
                                </td>

                                <td class="text-end">

                                    <button type="button"
                                            class="historial-detail-button"
                                            @onclick="() => VerDetalle(venta)">
                                        Ver detalle
                                    </button>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </section>

</div>

@if (VentaSeleccionada is not null)
{
    <div class="historial-modal-backdrop">

        <div class="historial-modal">

            <div class="historial-modal-header">

                <div>
                    <span class="historial-section-label">DETALLE DE VENTA</span>

                    <h2>
                        @VentaSeleccionada.NumeroFactura
                    </h2>

                    <p>
                        @VentaSeleccionada.Fecha.ToString("dd/MM/yyyy HH:mm:ss")
                    </p>
                </div>

                <button type="button"
                        class="historial-modal-close"
                        @onclick="CerrarDetalle">
                    ×
                </button>

            </div>

            <div class="historial-modal-body">

                <div class="historial-detail-grid">

                    <div>
                        <span>Cliente</span>
                        <strong>
                            @VentaSeleccionada.NombreCliente
                        </strong>
                    </div>

                    <div>
                        <span>RNC</span>
                        <strong>
                            @(string.IsNullOrWhiteSpace(VentaSeleccionada.RncCliente)
                                ? "No indicado"
                                : VentaSeleccionada.RncCliente)
                        </strong>
                    </div>

                    <div>
                        <span>Sucursal</span>
                        <strong>
                            @VentaSeleccionada.Sucursal.Nombre
                        </strong>
                    </div>

                    <div>
                        <span>Cajero</span>
                        <strong>
                            @VentaSeleccionada.Usuario.Nombre
                            @VentaSeleccionada.Usuario.Apellido
                        </strong>
                    </div>

                    <div>
                        <span>Método de pago</span>
                        <strong>
                            @VentaSeleccionada.MetodoPago
                        </strong>
                    </div>

                    <div>
                        <span>Estado</span>
                        <strong>
                            @VentaSeleccionada.Estado
                        </strong>
                    </div>

                </div>

                <div class="historial-detail-table-wrapper">

                    <table class="historial-detail-table">

                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Producto</th>
                                <th class="text-end">Cantidad</th>
                                <th class="text-end">Precio</th>
                                <th class="text-end">ITBIS</th>
                                <th class="text-end">ISC</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var detalle in VentaSeleccionada.Detalles)
                            {
                                <tr>

                                    <td>
                                        @detalle.CodigoProducto
                                    </td>

                                    <td>
                                        <strong>
                                            @detalle.NombreProducto
                                        </strong>
                                    </td>

                                    <td class="text-end">
                                        @detalle.Cantidad.ToString("N3")
                                    </td>

                                    <td class="text-end">
                                        RD$ @detalle.PrecioUnitario.ToString("N2")
                                    </td>

                                    <td class="text-end">
                                        RD$ @detalle.Itbis.ToString("N2")
                                    </td>

                                    <td class="text-end">
                                        RD$ @detalle.Isc.ToString("N2")
                                    </td>

                                    <td class="text-end">
                                        <strong>
                                            RD$ @detalle.Total.ToString("N2")
                                        </strong>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

                <div class="historial-totals">

                    <div>
                        <span>Subtotal</span>
                        <strong>
                            RD$ @VentaSeleccionada.Subtotal.ToString("N2")
                        </strong>
                    </div>

                    <div>
                        <span>ITBIS</span>
                        <strong>
                            RD$ @VentaSeleccionada.Itbis.ToString("N2")
                        </strong>
                    </div>

                    <div>
                        <span>ISC</span>
                        <strong>
                            RD$ @VentaSeleccionada.Isc.ToString("N2")
                        </strong>
                    </div>

                    <div class="historial-grand-total">
                        <span>Total</span>
                        <strong>
                            RD$ @VentaSeleccionada.Total.ToString("N2")
                        </strong>
                    </div>

                    @if (VentaSeleccionada.MontoRecibido.HasValue)
                    {
                        <div>
                            <span>Monto recibido</span>
                            <strong>
                                RD$ @VentaSeleccionada.MontoRecibido.Value.ToString("N2")
                            </strong>
                        </div>
                    }

                    @if (VentaSeleccionada.Cambio.HasValue)
                    {
                        <div>
                            <span>Cambio</span>
                            <strong>
                                RD$ @VentaSeleccionada.Cambio.Value.ToString("N2")
                            </strong>
                        </div>
                    }

                </div>

            </div>

            <div class="historial-modal-footer">

                <a class="historial-invoice-link"
                   href="@($"/factura/{Uri.EscapeDataString(VentaSeleccionada.NumeroFactura)}")"
                   target="_blank"
                   rel="noopener">
                    Ver / imprimir factura
                </a>

                <button type="button"
                        class="historial-button-secondary"
                        @onclick="CerrarDetalle">
                    Cerrar
                </button>

            </div>

        </div>

    </div>
}

